local function abrirMenuBloxFruits()
    local sg = Instance.new("ScreenGui")
    sg.Name = "NovaHubMenuBlox"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.Parent = getGuiParent()

    -- Fundo escurecido (blur visual leve com frame semitransparente)
    local overlay = Instance.new("Frame")
    overlay.Size = UDim2.fromScale(1, 1)
    overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    overlay.BackgroundTransparency = 1
    overlay.ZIndex = 0
    overlay.Parent = sg
    tween(overlay, {BackgroundTransparency = 0.45}, 0.3):Play()

    -- Cartão principal
    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(0, 300, 0, 0) -- altura animada
    mainFrame.AutomaticSize = Enum.AutomaticSize.Y
    mainFrame.Position = UDim2.new(0.5, -150, 0.5, -20)
    mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    mainFrame.BackgroundColor3 = Theme.Panel
    mainFrame.BorderSizePixel = 0
    mainFrame.ClipsDescendants = false
    mainFrame.Parent = sg
    corner(mainFrame, 14)
    stroke(mainFrame, Theme.Stroke, 1)

    -- animação de entrada
    mainFrame.Size = UDim2.new(0, 260, 0, 0)
    local sizeGoal = UDim2.new(0, 300, 0, 0)
    mainFrame.BackgroundTransparency = 1
    tween(mainFrame, {Size = sizeGoal, BackgroundTransparency = 0}, 0.3):Play()

    local layout = Instance.new("UIListLayout")
