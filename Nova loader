-- ROTEAMENTO
----------------------------------------------------------------
if bloxFruitsIds[PlaceId] then
    abrirMenuBloxFruits()
elseif breakIn2Ids[PlaceId] then
    notify("Nova Hub", "Carregando Break In 2...", 3)
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://pastefy.app/jes7xB1U/raw"))()
    end)
    if success then
        notify("Nova Hub", "Break In 2 carregado com sucesso!", 5)
        scriptLoaded = true
    else
        notify("Nova Hub", "Erro ao carregar: " .. tostring(err), 5)
    end
elseif dandysWorldIds[PlaceId] then
    notify("Nova Hub", "Carregando Dandy's World...", 3)
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/shhskshdjsjsjsh-source/Novahubmain/refs/heads/main/Dandys-World"))()
    end)
    if success then
        notify("Nova Hub", "Dandy's World carregado com sucesso!", 5)
        scriptLoaded = true
    else
        notify("Nova Hub", "Erro ao carregar: " .. tostring(err), 5)
    end
elseif PlaceId == 78515283254292 then
    notify("Nova Hub", "O script só funciona dentro da partida", 5)
elseif scripts[tostring(PlaceId)] then
    local scriptData = scripts[tostring(PlaceId)]
    notify("Nova Hub", "Carregando " .. scriptData.name .. "...", 3)

    local success, err = pcall(function()
        loadstring(game:HttpGet(scriptData.url))()
    end)

    if success then
        notify("Nova Hub", scriptData.name .. " carregado com sucesso!", 5)
        scriptLoaded = true
    else
        notify("Nova Hub", "Erro ao carregar: " .. tostring(err), 5)
    end
else
    notify("Nova Hub", "Nenhum script encontrado para este jogo (ID: " .. tostring(PlaceId) .. ")", 5)
end
