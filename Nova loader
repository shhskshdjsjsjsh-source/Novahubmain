    eyebrow.Position = UDim2.new(0, 34, 0, 8)
    eyebrow.Size = UDim2.new(1, -50, 0, 16)
    eyebrow.Text = "NOVA HUB"
    eyebrow.TextColor3 = Theme.SubText
    eyebrow.TextSize = 11
    eyebrow.Font = Enum.Font.GothamBold
    eyebrow.TextXAlignment = Enum.TextXAlignment.Left
    eyebrow.Parent = header

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 20, 0, 24)
    title.Size = UDim2.new(1, -40, 0, 28)
    title.Text = "Blox Fruits"
    title.TextColor3 = Theme.Text
    title.TextSize = 19
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = header

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 26, 0, 26)
    closeBtn.Position = UDim2.new(1, -38, 0, 10)
    closeBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    closeBtn.BackgroundTransparency = 0.6
    closeBtn.Text = "×"
    closeBtn.TextColor3 = Theme.Text
    closeBtn.TextSize = 18
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.Parent = header
    corner(closeBtn, 13)
    closeBtn.MouseButton1Click:Connect(function()
        tween(mainFrame, {BackgroundTransparency = 1}, 0.15):Play()
        tween(overlay, {BackgroundTransparency = 1}, 0.15):Play()
        task.wait(0.16)
        sg:Destroy()
    end)

    -- Container das opções
    local optionsHolder = Instance.new("Frame")
    optionsHolder.BackgroundTransparency = 1
    optionsHolder.Size = UDim2.new(1, 0, 0, 0)
    optionsHolder.AutomaticSize = Enum.AutomaticSize.Y
    optionsHolder.LayoutOrder = 1
