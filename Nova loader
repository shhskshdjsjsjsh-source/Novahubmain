    optPad.PaddingRight = UDim.new(0, 16)
    optPad.PaddingTop = UDim.new(0, 14)
    optPad.Parent = optionsHolder

    local function criarOpcao(nome, url, ordem, subtitulo)
        local card = Instance.new("TextButton")
        card.Size = UDim2.new(1, 0, 0, 52)
        card.BackgroundColor3 = Theme.PanelAlt
        card.AutoButtonColor = false
        card.Text = ""
        card.LayoutOrder = ordem
        card.Parent = optionsHolder
        corner(card, 10)
        local cardStroke = stroke(card, Theme.Stroke, 1)

        local icon = Instance.new("Frame")
        icon.Size = UDim2.new(0, 4, 1, -16)
        icon.Position = UDim2.new(0, 8, 0, 8)
        icon.BackgroundColor3 = Theme.Accent
        icon.BorderSizePixel = 0
        icon.Parent = card
        corner(icon, 2)

        local nameLabel = Instance.new("TextLabel")
        nameLabel.BackgroundTransparency = 1
        nameLabel.Position = UDim2.new(0, 24, 0, 6)
        nameLabel.Size = UDim2.new(1, -40, 0, 20)
        nameLabel.Text = nome
        nameLabel.TextColor3 = Theme.Text
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.GothamMedium
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.Parent = card

        local subLabel = Instance.new("TextLabel")
        subLabel.BackgroundTransparency = 1
        subLabel.Position = UDim2.new(0, 24, 0, 26)
        subLabel.Size = UDim2.new(1, -40, 0, 16)
        subLabel.Text = subtitulo or "Toque para carregar"
        subLabel.TextColor3 = Theme.SubText
        subLabel.TextSize = 11
        subLabel.Font = Enum.Font.Gotham
        subLabel.TextXAlignment = Enum.TextXAlignment.Left
        subLabel.Parent = card

        card.MouseEnter:Connect(function()
            tween(card, {BackgroundColor3 = Color3.fromRGB(36, 36, 48)}, 0.15):Play()
            tween(cardStroke, {Color = Theme.Accent}, 0.15):Play()
        end)
        card.MouseLeave:Connect(function()
            tween(card, {BackgroundColor3 = Theme.PanelAlt}, 0.15):Play()
            tween(cardStroke, {Color = Theme.Stroke}, 0.15):Play()
        end)

        card.MouseButton1Click:Connect(function()
            tween(mainFrame, {BackgroundTransparency = 1}, 0.15):Play()
            tween(overlay, {BackgroundTransparency = 1}, 0.15):Play()
            task.wait(0.16)
            sg:Destroy()
            notify("Nova Hub", "Carregando " .. nome .. "...", 3)
            local success, err = pcall(function()
                loadstring(game:HttpGet(url))()
            end)
            if success then
                notify("Nova Hub", nome .. " carregado!", 4)
                scriptLoaded = true
            else
                notify("Nova Hub", "Erro ao injetar script: " .. tostring(err), 5)
            end
        end)
    end

    criarOpcao("Kaitun", "https://raw.githubusercontent.com/shhskshdjsjsjsh-source/Novahubmain/refs/heads/main/NovaKaitun", 1, "Auto-Farm completo")
    criarOpcao("Main Redz", "https://raw.githubusercontent.com/shhskshdjsjsjsh-source/Novahubmain/refs/heads/main/Novahub-bloxfruits", 2, "Script principal")
    criarOpcao("Main Banana", "https://pastefy.app/LpL9NMt1/raw", 3, "Script alternativo")

    -- Rodapé
    local footer = Instance.new("TextLabel")
    footer.BackgroundTransparency = 1
    footer.Size = UDim2.new(1, 0, 0, 16)
    footer.LayoutOrder = 2
    footer.Text = "Nova Hub • by Nexustester"
    footer.TextColor3 = Theme.SubText
    footer.TextSize = 10
    footer.Font = Enum.Font.Gotham
    footer.Parent = mainFrame
end

